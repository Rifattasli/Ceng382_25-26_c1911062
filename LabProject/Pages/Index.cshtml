@page
@model LabProject.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2>Class List</h2>

    <!-- Filter -->
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by class name..." />
        </div>
        <div class="col-md-6">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-page="/Classes/Create" class="btn btn-success">Add New Class</a>
        </div>
    </form>

    <!-- Export -->
    <form method="post" asp-page-handler="Export">
        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
        <button type="submit" class="btn btn-outline-success mb-3">Export JSON</button>
    </form>

    <!-- Table -->
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Person Count</th>
                <th>Description</th>
                <th>Is Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ClassList)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.PersonCount</td>
                    <td>@item.Description</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a asp-page="/Classes/Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-page="/Classes/Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-page="/Index"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-PageNumber="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>