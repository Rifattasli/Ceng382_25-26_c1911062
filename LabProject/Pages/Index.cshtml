@page
@model LabProject.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<div class="container mt-5">
    <div class="row">
       

        <!-- LEFT: Form -->
        <div class="col-md-6">
            <h4>@(Model.NewClass?.Id > 0 ? "Edit Class" : "Add Class")</h4>

            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />

                <div class="mb-3">
                    <label asp-for="NewClass.ClassName" class="form-label"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.StudentCount" class="form-label"></label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.Description" class="form-label"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>

                <button type="submit" asp-page-handler="@(Model.NewClass?.Id > 0 ? "Update" : "Add")" class="btn btn-primary">
                    @(Model.NewClass?.Id > 0 ? "Update" : "Add")
                </button>
            </form>
        </div>

        <!-- RIGHT: Table -->
        <div class="col-md-6">
            <h4>Class List</h4>

            <!-- Filter -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="FilterName" value="@Model.FilterName" class="form-control" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>

            <!-- Export -->
            <form method="post" asp-page-handler="Export" class="mb-3">
                <input type="hidden" name="IsFiltered" value="true" />
                <input type="hidden" name="FilterName" value="@Model.FilterName" />
                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                <input type="hidden" name="SelectedColumns" value="@string.Join(",", Model.SelectedColumns)" />
                <button type="submit" class="btn btn-success">Export Current Page to JSON</button>
            </form>

            <!-- Table -->
            <table class="table table-bordered">
                <thead>
                    <tr>
                        @foreach (var column in new[] { "ClassName", "StudentCount", "Description" })
                        {
                            bool isSelected = Model.SelectedColumns.Contains(column);
                            string thClass = isSelected ? "table-primary" : "";

                            var updatedColumns = new List<string>(Model.SelectedColumns);
                            if (isSelected) updatedColumns.Remove(column);
                            else updatedColumns.Add(column);

                            string href = $"/Index?FilterName={Model.FilterName}&PageNumber={Model.PageNumber}";
                            foreach (var col in updatedColumns)
                            {
                                href += $"&SelectedColumns={col}";
                            }

                            <th class="@thClass">
                                <a href="@href" class="text-dark text-decoration-none d-block">@column</a>
                            </th>
                        }
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredList)
                    {
                        <tr>
                            <td class="@(Model.SelectedColumns.Contains("ClassName") ? "table-primary" : "")">@item.ClassName</td>
                            <td class="@(Model.SelectedColumns.Contains("StudentCount") ? "table-primary" : "")">@item.StudentCount</td>
                            <td class="@(Model.SelectedColumns.Contains("Description") ? "table-primary" : "")">@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@($"/Index?FilterName={Model.FilterName}&PageNumber={i}&{string.Join("&", Model.SelectedColumns.Select(c => $"SelectedColumns={c}"))}")">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
