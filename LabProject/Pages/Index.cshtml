@page
@model LabProject.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<div class="container mt-5">

    <form method="post" asp-page-handler="Logout" class="text-end mb-3">
    <button type="submit" class="btn btn-danger btn-sm">Logout</button>
</form>
    <div class="row">
    
        <div class="col-md-6">
            <h4>@(Model.NewClass?.Id > 0 ? "Edit Class" : "Add Class")</h4>

            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />

                <div class="mb-3">
                    <label asp-for="NewClass.ClassName" class="form-label"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.StudentCount" class="form-label"></label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.Description" class="form-label"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>

                <button type="submit" asp-page-handler="@(Model.NewClass?.Id > 0 ? "Update" : "Add")" class="btn btn-primary">
                    @(Model.NewClass?.Id > 0 ? "Update" : "Add")
                </button>
            </form>
        </div>

        
        <div class="col-md-6">
            <h4>Class List</h4>

            
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="FilterName" value="@Model.FilterName" class="form-control" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>

<form method="post" asp-page-handler="Export" class="mb-3">

    <input type="hidden" name="IsFiltered" value="true" />
    <input type="hidden" name="FilterName" value="@Model.FilterName" />
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" name="columns" value="ClassName" checked>
        <label class="form-check-label">Class Name</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" name="columns" value="StudentCount" checked>
        <label class="form-check-label">Student Count</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" name="columns" value="Description" checked>
        <label class="form-check-label">Description</label>
    </div>

    <div class="mt-2">
        <input type="hidden" name="IsFiltered" value="true" /> 
        <button type="submit" class="btn btn-success">Export to JSON</button>
    </div>
</form>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-FilterName="@Model.FilterName"
                               asp-route-PageNumber="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}