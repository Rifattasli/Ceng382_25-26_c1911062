@page "{id:int}"
@model LabProject.Pages.Classes.DeleteModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2>Delete Class</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this?
    </div>

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Class.Name</dd>

        <dt class="col-sm-2">Person Count</dt>
        <dd class="col-sm-10">@Model.Class.PersonCount</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Class.Description</dd>

        <dt class="col-sm-2">Is Active</dt>
        <dd class="col-sm-10">@(Model.Class.IsActive ? "Yes" : "No")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Class.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>