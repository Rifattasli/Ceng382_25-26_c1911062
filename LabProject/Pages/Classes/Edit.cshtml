@page "{id:int}"
@model LabProject.Pages.Classes.EditModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2>Edit Class</h2>

    <form method="post">
        <input type="hidden" asp-for="Class.Id" />

        <div class="mb-3">
            <label asp-for="Class.Name" class="form-label"></label>
            <input asp-for="Class.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Class.PersonCount" class="form-label"></label>
            <input asp-for="Class.PersonCount" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Class.Description" class="form-label"></label>
            <textarea asp-for="Class.Description" class="form-control"></textarea>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Class.IsActive" class="form-check-input" />
            <label asp-for="Class.IsActive" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
        <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
